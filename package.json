{
  "name": "react-spa-boilerplate",
  "private": true,
  "version": "0.0.0",
  "description": "A React SPA boilerplate project with TypeScript & Vite.",
  "license": "Apache-2.0",
  "author": "ryan goree (https://github.com/ryangoree)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryangoree/react-spa-boilerplate.git"
  },
  "type": "module",
  "scripts": {
    "generate:typescale": "typescale --tailwind -o src/ui/styles/typescale.css",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest --reporter=verbose",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && biome check --diagnostic-level error . ",
    "fix": "npm run format && biome check --diagnostic-level error . --write",
    "fix:unsafe": "npm run fix --unsafe",
    "format:biome": "biome format --write",
    "format:prettier": "prettier . --write",
    "format": "npm run format:biome && npm run format:prettier",
    "typecheck:watch": "tsc --noEmit --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@gud/typescale": "^2.0.3",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
